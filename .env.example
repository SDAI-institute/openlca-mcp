# ── openLCA IPC connection ────────────────────────────────────────────────────
# Host where openLCA is running.
#   Local (no Docker): localhost
#   Docker local dev:  host.docker.internal  (set automatically by docker-compose.yml)
#   Production:        IP or hostname of the machine running openLCA
OPENLCA_HOST=localhost
OPENLCA_PORT=8080
# Per-call IPC timeout in seconds. Bounds every openLCA request so an
# unreachable/black-holed host fails fast with a clean CONNECTION_FAILED error
# instead of hanging the server (which behind a proxy/tunnel surfaces as a 502).
OPENLCA_TIMEOUT=15

# ── Connection profiles (multi-instance) ──────────────────────────────────────
# A single server can target several openLCA instances. OPENLCA_HOST/PORT above
# always define the synthesized `default` profile (your local desktop openLCA, so
# created entities show up in the openLCA UI). Add more named profiles either
# inline as JSON or via a file. Each tool accepts an optional `connection` arg.
#   OPENLCA_CONNECTIONS=[{"id":"remote","host":"100.107.240.54","port":8080,"kind":"remote"}]
# OPENLCA_CONNECTIONS_FILE=config/connections.json   # see config/connections.example.json

# ── Auth / multi-tenancy ──────────────────────────────────────────────────────
# Map API keys to a tenant + the connection profiles it may use. When UNSET the
# server runs in OPEN mode (anonymous callers, default profile only). When set,
# requests need a matching bearer token (Authorization: Bearer <key>; the Caddy
# gateway also accepts ?api_key=<key>). Inline JSON or a file:
#   OPENLCA_API_KEYS={"sk_live_xxx":{"tenant_id":"acme","allowed_profiles":["default"]}}
# OPENLCA_API_KEYS_FILE=config/api_keys.json         # see config/api_keys.example.json

# ── Telemetry ─────────────────────────────────────────────────────────────────
# Anonymous, opt-out usage telemetry so the maintainer can see which tools are
# used, how fast they run, and which error codes appear most often.
#
# What is sent:  tool name · success bool · error code · duration ms
#                server version · transport · random ephemeral session id
# What is NEVER sent:  arguments · result content · IPs · usernames · file paths
#
# Full source: src/telemetry.py  |  docs: docs/telemetry.md
#
# Opt out (either works):
OPENLCA_TELEMETRY=true
# DO_NOT_TRACK=1
#
# Debug — prints exactly what would be sent, nothing is actually exported:
# OPENLCA_TELEMETRY_DEBUG=true
#
# ── Grafana Cloud / OTLP (traces + metrics: latency, error rates, performance) ─
# OPENLCA_TELEMETRY_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:apiKey)>
#
# ── PostHog (product analytics: tool rankings, funnels, unique installs) ───────
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com   # EU: https://eu.i.posthog.com
#
# ── Safe mode ─────────────────────────────────────────────────────────────────
# When true, the server connects in read-only mode: every database write
# (create_product_flow / create_process / create_product_system, and any other
# put/delete) is blocked and returns a structured WRITE_BLOCKED error. Reads,
# searches, and calculations are unaffected. Default: false (writes allowed).
OPENLCA_READ_ONLY=false

# ── Transport ─────────────────────────────────────────────────────────────────
# stdio : default, used by Claude Desktop / local AI clients
# sse   : legacy HTTP+SSE transport only (/sse + /messages/)
# streamable-http : modern MCP endpoint only (/mcp)
# http  : recommended network mode; serves both /mcp and /sse
TRANSPORT=stdio

# ── HTTP server (network transports only) ─────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
MCP_SSE_PATH=/sse
MCP_MESSAGE_PATH=/messages/

# In TRANSPORT=http, both endpoints are enabled by default.
MCP_ENABLE_STREAMABLE_HTTP=true
MCP_ENABLE_SSE=true

# Recommended for remote production deployments using /mcp.
MCP_STATELESS_HTTP=true
MCP_HTTP_JSON_RESPONSE=true
# MCP_SESSION_IDLE_TIMEOUT=1800

# Optional DNS rebinding protection for public deployments.
# When enabled, set explicit allowlists for your public host/origin values.
MCP_DNS_REBINDING_PROTECTION=false
# MCP_ALLOWED_HOSTS=mcp.yourdomain.com,mcp.yourdomain.com:443
# MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai,https://mcp.yourdomain.com

# ── Streaming gateway (docker-compose.gateway.yml only) ───────────────────────
# Front the server with a Caddy proxy that disables response buffering, so MCP
# streams survive a buffering reverse proxy or tunnel. Without this, remote
# connectors (ChatGPT, Claude) connect but show NO tools. See gateway/Caddyfile.
#
# Host port the gateway listens on (point your tunnel here).
GATEWAY_PORT=8030
# Optional shared secret. Empty = no auth. When set, clients must pass it as
# ?api_key=<token> (or Authorization: Bearer <token>) — ChatGPT can only do the query form.
# Generate one:  openssl rand -hex 32
#   Windows:      python -c "import secrets; print(secrets.token_hex(32))"
MCP_AUTH_TOKEN=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Production (docker-compose.prod.yml only) ─────────────────────────────────
# Your domain pointing to this server (DNS A-record must resolve first)
MCP_DOMAIN=mcp.yourdomain.com
# Email for Let's Encrypt certificate notifications
ACME_EMAIL=you@yourdomain.com
# Optional HTTP Basic Auth (generated with htpasswd, $ doubled for compose)
# MCP_BASIC_AUTH=user:$$apr1$$...
